<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- xUnit v3 test projects are self-hosting executables, not class libraries. -->
    <OutputType>Exe</OutputType>

    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />

    <!-- Not plain xunit.v3: that variant enables Microsoft.Testing.Platform, and this
         solution runs tests through VSTest. The two are not interchangeable. Same set
         and same versions as tests/MeetingRooms.UnitTests, deliberately - two test
         projects disagreeing about their runner is a problem that shows up as a
         mysteriously empty test run. -->
    <PackageReference Include="xunit.v3.mtp-off" Version="3.2.2" />

    <!-- WebApplicationFactory. It also emits the content-root attribute into this
         assembly that lets the test host find the API project's appsettings.json at its
         source path, rather than expecting a copy next to the test binaries. -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- Read from the test binaries folder by BookingApiFactory, not from the API project's
         content root - which is where a bare relative path would resolve. -->
    <None Update="appsettings.Tests.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- The API project, for Program - which task 7 makes public. Application,
         Infrastructure and Domain arrive transitively, which is how the database
         assertions reach AppDbContext without a second reference to maintain. -->
    <ProjectReference Include="..\..\src\backend\MeetingRooms.Api\MeetingRooms.Api.csproj" />
  </ItemGroup>

</Project>
